{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jemu64.local/schemas/copier_matrix.schema.json",
  "title": "Jemu64 Copier Matrix",
  "type": "object",
  "required": [
    "version",
    "defaults",
    "scenarios"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "defaults": {
      "type": "object",
      "required": [
        "require_no_host_fallback",
        "checksum_algorithm",
        "artifacts"
      ],
      "properties": {
        "require_no_host_fallback": {
          "type": "boolean"
        },
        "checksum_algorithm": {
          "type": "string",
          "enum": [
            "fnv1a64"
          ]
        },
        "artifacts": {
          "type": "object",
          "required": [
            "manifest_csv",
            "report_json"
          ],
          "properties": {
            "manifest_csv": {
              "type": "string",
              "minLength": 1
            },
            "report_json": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "level",
          "mode",
          "source_unit",
          "target_unit",
          "source_format",
          "target_format",
          "gates"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "description": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "baseline",
              "strict",
              "advanced"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "file_copy",
              "disk_copy"
            ]
          },
          "source_unit": {
            "type": "integer",
            "minimum": 8,
            "maximum": 11
          },
          "target_unit": {
            "type": "integer",
            "minimum": 8,
            "maximum": 11
          },
          "source_format": {
            "type": "string",
            "enum": [
              "d64",
              "g64",
              "nib",
              "raw"
            ]
          },
          "target_format": {
            "type": "string",
            "enum": [
              "d64",
              "g64",
              "nib",
              "raw"
            ]
          },
          "gates": {
            "type": "object",
            "required": [
              "required_markers",
              "require_manifest_match"
            ],
            "properties": {
              "required_markers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "require_manifest_match": {
                "type": "boolean"
              },
              "expected_manifest_columns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
