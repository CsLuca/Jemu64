{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "level5_oracle.schema.json",
  "title": "Level5 Oracle",
  "type": "object",
  "required": [
    "oracle_version",
    "title_id",
    "timing_window",
    "iec_behavior",
    "error_semantics",
    "loader_profile",
    "weak_sync_profile"
  ],
  "properties": {
    "oracle_version": {
      "type": "integer",
      "minimum": 1
    },
    "title_id": {
      "type": "string",
      "minLength": 1
    },
    "timing_window": {
      "type": "object",
      "required": ["max_halfcycles", "min_done_hits"],
      "properties": {
        "max_halfcycles": { "type": "integer", "minimum": 1 },
        "min_done_hits": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "iec_behavior": {
      "type": "object",
      "required": ["require_no_host_fallback", "max_retry_count"],
      "properties": {
        "require_no_host_fallback": { "type": "boolean" },
        "max_retry_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "error_semantics": {
      "type": "object",
      "required": ["expected_dos_codes", "max_unexpected_error_rows"],
      "properties": {
        "expected_dos_codes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "max_unexpected_error_rows": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "loader_profile": {
      "type": "object",
      "required": ["parity_min_runs", "parity_max_mismatch_rows"],
      "properties": {
        "parity_min_runs": { "type": "integer", "minimum": 0 },
        "parity_max_mismatch_rows": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "weak_sync_profile": {
      "type": "object",
      "required": ["min_weak_events", "min_sync_recovery_events"],
      "properties": {
        "min_weak_events": { "type": "integer", "minimum": 0 },
        "min_sync_recovery_events": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
